{
  "name": "teamflow-server",
  "version": "1.0.0",
  "description": "TeamFlow Backend — Express + MongoDB + JWT",
  "main": "server.js",
  "type": "commonjs",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3", //for hashing passwords
    "cors": "^2.8.5", //telling which website can access our api's
    "dotenv": "^16.4.5", //for environment variables
    "express": "^4.19.2", //for building the API
    "express-rate-limit": "^8.5.2", //for rate limiting
    "express-validator": "^7.1.0",
    "helmet": "^8.2.0", //for security
    "jsonwebtoken": "^9.0.2", //for JSON Web Tokens
    "mongoose": "^8.4.1", //for MongoDB
    "morgan": "^1.10.0", //for logging
    "nodemailer": "^9.0.0" //for sending emails
  },
  "devDependencies": {
    "nodemon": "^3.1.3"
  }
}
